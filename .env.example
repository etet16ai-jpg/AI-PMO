# Copy this file to ".env" and fill in real values. ".env" is gitignored.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# n8n instance
# ---------------------------------------------------------------------------

# Public hostname for this instance (needs a DNS A record -> this server,
# and a matching block in the Caddyfile — see Caddyfile.snippet).
N8N_HOST=final.siteflys.com

# n8n data-at-rest encryption key. MUST stay constant for the life of the
# instance or stored credentials become unreadable. Generate once with:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Project services — set as n8n CREDENTIALS inside the editor, not here.
# Listed only so you know what the project needs. Do NOT paste secrets in
# this repo; keep them in n8n's own credential store.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=...            # chat models + embeddings (RAG)
# TELEGRAM_MANAGER_BOT_TOKEN=...# bot #1 — owner analytics
# TELEGRAM_CUSTOMER_BOT_TOKEN=...# bot #2 — customer service
# AIRTABLE_PAT=...              # Airtable personal access token
# AIRTABLE_BASE_ID=...          # the project's Airtable base
# GMAIL_OAUTH_CLIENT_ID=...     # dedicated Google Cloud OAuth app
# GMAIL_OAUTH_CLIENT_SECRET=...
