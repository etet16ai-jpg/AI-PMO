      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head><meta charset=\"utf-8\">\n<style>\n  body{font-family:Arial,Helvetica,sans-serif;background:#f4f4f7;margin:0;padding:24px;color:#1a1a1a}\n  .inv{max-width:640px;margin:0 auto;background:#fff;border:1px solid #ddd;border-radius:8px;padding:32px}\n  .head{display:flex;justify-content:space-between;border-bottom:2px solid #0b1f3a;padding-bottom:16px;margin-bottom:24px}\n  .brand{font-size:22px;font-weight:bold;color:#0b1f3a}\n  .brand small{display:block;font-size:12px;font-weight:normal;color:#666}\n  .meta{text-align:left;font-size:14px;line-height:1.8}\n  table{width:100%;border-collapse:collapse;margin:20px 0}\n  th,td{border:1px solid #ddd;padding:10px;text-align:right;font-size:14px}\n  th{background:#f0f2f5}\n  .total-row td{font-weight:bold;font-size:16px;background:#f0f2f5}\n  .foot{margin-top:24px;font-size:12px;color:#666;border-top:1px solid #eee;padding-top:12px}\n</style></head>\n<body>\n  <div class=\"inv\">\n    <div class=\"head\">\n      <div class=\"brand\">AI Electronics<small>עוסק מורשה 000000000</small></div>\n      <div class=\"meta\">\n        <div>חשבונית מס <b>{{ $json.fields.InvoiceNumber }}</b></div>\n        <div>תאריך: {{ $now.format('dd/MM/yyyy') }}</div>\n        <div>לקוח: {{ $json.fields.CustomerId }}</div>\n      </div>\n    </div>\n    <table>\n      <tr><th>תיאור</th><th>סכום לפני מע\"מ</th><th>מע\"מ (18%)</th><th>סה\"כ</th></tr>\n      <tr>\n        <td>מוצרי אלקטרוניקה</td>\n        <td>{{ $json.fields.Amount }} &#8362;</td>\n        <td>{{ $json.fields.VatAmount }} &#8362;</td>\n        <td>{{ $json.fields.Total }} &#8362;</td>\n      </tr>\n      <tr class=\"total-row\"><td colspan=\"3\">סה\"כ לתשלום</td><td>{{ $json.fields.Total }} &#8362;</td></tr>\n    </table>\n    <div class=\"foot\">מסמך זה הופק אוטומטית ע\"י מערכת AI Electronics.</div>\n  </div>\n</body>\n</html>\n"
